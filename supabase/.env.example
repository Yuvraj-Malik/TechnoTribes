# Copy to supabase/.env (never commit it). Used by `npm run db:auth`.
# Get these from Google Cloud Console -> APIs & Services -> Credentials -> your OAuth client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-your-secret
