{
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/index?route=:route"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/team/drift/cron",
      "schedule": "0 6 * * *"
    }
  ]
}
