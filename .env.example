# Copy to .env.local and fill in. Never commit .env.local.

# --- Server only (used by /api) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Agent models, written provider:model (providers: groq, gemini, openrouter, anthropic).
# A rate-limited or failing model hands over to FALLBACK_MODEL. With no keys, agents are simulated.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
BUILDER_MODEL=groq:llama-3.3-70b-versatile
CRITIC_MODEL=groq:llama-3.1-8b-instant
FALLBACK_MODEL=gemini:gemini-2.5-flash
# AGENT_MODE=mock forces the simulated agents.
AGENT_MODE=
GITHUB_TOKEN=

# --- Browser (used by src/, safe to expose) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Google OAuth (configure in Google Cloud & Supabase Auth Providers) ---
# The app itself never reads these. Put the Google Client ID and secret in
# supabase/.env (copy supabase/.env.example) and run `npm run db:auth`,
# or paste them into Supabase -> Authentication -> Providers -> Google.

# --- Coordination layer (optional) ---
# Smaller Claude model for routine checks (the reviewer agent)
CLAUDE_ROUTINE_MODEL=claude-haiku-5-5
# Search by meaning (Voyage embeddings). Without it, search matches keywords.
VOYAGE_API_KEY=
# Secret Vercel Cron sends to /api/team/drift/cron (daily drift check)
CRON_SECRET=
